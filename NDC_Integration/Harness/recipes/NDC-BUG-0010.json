{
  "id": "NDC-BUG-0010",
  "title": "[V2][Airline][GetBundle] – No Available Bundles Returned for Selected Criteria (409 Conflict)",
  "source": "Resources/AirArabiaPlus_bugs.xlsx row 12 (generic [Airline] row, tested for AirArabiaPlus only - rule 4)",
  "supplier": "AirArabiaPlus",
  "selector": "USA",
  "version": "V2",
  "testData": "TestData/AAP_1ADT1CHD1INF_COK-SHJ_OW.json",
  "chain": [
    {
      "step": "Search",
      "offer": {
        "direct": true,
        "flags": {
          "haveBundles": true
        }
      }
    },
    "FareConfirm",
    {
      "step": "GetOfferBundles",
      "pick": false,
      "allowFail": true
    }
  ],
  "assert": [
    {
      "step": "GetOfferBundles",
      "path": "$status",
      "op": "equals",
      "value": 200
    },
    {
      "step": "GetOfferBundles",
      "path": "$.bundleChoices.*",
      "op": "exists"
    }
  ],
  "reproduces": [
    {
      "step": "GetOfferBundles",
      "path": "$status",
      "op": "equals",
      "value": 409
    },
    {
      "step": "GetOfferBundles",
      "path": "$text",
      "op": "matches",
      "value": "/No Available Bundles/i"
    }
  ],
  "fixedWhen": "all asserts pass",
  "neighbours": [],
  "notes": "Only offers flagged haveBundles=true are used, so a 409 cannot come from an offer that never had bundles.",
  "approved": {
    "by": "Mostafa Ebrahim Mostafa",
    "date": "2026-11-17",
    "sha": "bfd73ab1ce6339b1"
  }
}
