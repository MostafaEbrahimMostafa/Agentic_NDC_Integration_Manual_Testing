{
  "id": "NDC-BUG-0008",
  "title": "[V2][Airline][FareConfirm] – RBD Mismatch Between Search and FareConfirm Responses",
  "source": "Resources/AirArabiaPlus_bugs.xlsx row 9 (generic [Airline] row, tested for AirArabiaPlus only - rule 4)",
  "supplier": "AirArabiaPlus",
  "selector": "USA",
  "version": "V2",
  "testData": "TestData/AAP_1ADT1CHD1INF_COK-SHJ_OW.json",
  "chain": [
    {
      "step": "Search",
      "offer": {
        "direct": true
      }
    },
    "FareConfirm"
  ],
  "assert": [
    {
      "step": "FareConfirm",
      "path": "$.selectedOffer.passengerFareBreakdown[*].segmentDetails.*.rbd",
      "op": "equalsStep",
      "other": {
        "step": "Search",
        "path": "$._selectedOffer.passengerFareBreakdown[*].segmentDetails.*.rbd"
      }
    }
  ],
  "reproduces": [
    {
      "step": "FareConfirm",
      "path": "$.selectedOffer.passengerFareBreakdown[*].segmentDetails.*.rbd",
      "op": "notEqualsStep",
      "other": {
        "step": "Search",
        "path": "$._selectedOffer.passengerFareBreakdown[*].segmentDetails.*.rbd"
      }
    }
  ],
  "fixedWhen": "all asserts pass",
  "neighbours": [],
  "notes": "Compares the rbd of the offer chosen in Search with the rbd FareConfirm returns for it.",
  "approved": {
    "by": "Mostafa Ebrahim Mostafa",
    "date": "2026-11-17",
    "sha": "84b39ef5657d550f"
  }
}
