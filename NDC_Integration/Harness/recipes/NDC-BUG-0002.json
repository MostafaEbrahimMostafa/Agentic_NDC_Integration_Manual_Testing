{
  "id": "NDC-BUG-0002",
  "title": "[V2][AirArabiaPlus][Book] – paxTotalAncillaryAmount Differs Between Book/FareCheck and Retrieve for the Same Booking",
  "source": "Resources/AirArabiaPlus_bugs.xlsx row 3; ADO 65507; KB/02_Suppliers/AirArabiaPlus.md §4",
  "supplier": "AirArabiaPlus",
  "selector": "USA",
  "version": "V2",
  "testData": "TestData/AAP_1ADT1CHD1INF_COK-SHJ_OW.json",
  "attempts": 3,
  "chain": [
    {
      "step": "Search",
      "offer": {
        "direct": true,
        "flags": {
          "haveBundles": true
        }
      }
    },
    "FareConfirm",
    {
      "step": "GetOfferBundles",
      "bundle": "66589"
    },
    "AddPassenger",
    {
      "step": "GetAncillary",
      "meal": {
        "price": 264.32
      },
      "baggage": true
    },
    "SeatMap",
    "FareCheck",
    "Book",
    "Retrieve"
  ],
  "preconditions": [
    {
      "step": "Book",
      "path": "$.pnr",
      "op": "exists"
    }
  ],
  "assert": [
    {
      "step": "Retrieve",
      "path": "$.selectedOffer.passengerFareBreakdown[*].paxTotalAncillaryAmount",
      "op": "equalsStep",
      "other": {
        "step": "FareCheck",
        "path": "$.selectedOffer.passengerFareBreakdown[*].paxTotalAncillaryAmount"
      }
    },
    {
      "step": "Retrieve",
      "path": "$.selectedOffer.passengerFareBreakdown[*].paxTotalAncillaryAmount",
      "op": "equalsStep",
      "other": {
        "step": "Book",
        "path": "$.selectedOffer.passengerFareBreakdown[*].paxTotalAncillaryAmount"
      }
    },
    {
      "step": "Retrieve",
      "path": "$.selectedOffer.priceDetails.totalAncillariesAmount",
      "op": "equalsStep",
      "other": {
        "step": "FareCheck",
        "path": "$.selectedOffer.priceDetails.totalAncillariesAmount"
      }
    }
  ],
  "reproduces": [
    {
      "step": "Retrieve",
      "path": "$.selectedOffer.passengerFareBreakdown[*].paxTotalAncillaryAmount",
      "op": "notEqualsStep",
      "other": {
        "step": "FareCheck",
        "path": "$.selectedOffer.passengerFareBreakdown[*].paxTotalAncillaryAmount"
      }
    }
  ],
  "fixedWhen": "all asserts pass",
  "neighbours": [
    {
      "flow": "FLOW-V2-67",
      "stepOptions": {
        "GetOfferBundles": {
          "bundle": "66624"
        }
      }
    }
  ],
  "notes": "Only bundle 66589 + the paid 264.32 meal triggers the mismatch (KB). If that bundle or meal is not offered the verdict is Blocked, never Fixed. FareCheck sometimes rejects offered items (NDC-BUG-0006), so the chain is retried up to 3 times; the retries stop before Book, so they leave no tickets.",
  "approved": {
    "by": "Mostafa Ebrahim Mostafa",
