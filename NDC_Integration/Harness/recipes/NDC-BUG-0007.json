{
  "id": "NDC-BUG-0007",
  "title": "[V2][Airline][Search] – baggageDetailsRefId Returned as Null for INF Passenger",
  "source": "Resources/AirArabiaPlus_bugs.xlsx row 8",
  "supplier": "AirArabiaPlus",
  "selector": "USA",
  "version": "V2",
  "testData": "TestData/AAP_1ADT1INF_MCT-SHJ_OW.json",
  "chain": [
    {
      "step": "Search",
      "offer": {
        "direct": true
      }
    }
  ],
  "preconditions": [
    {
      "step": "Search",
      "path": "$.offers[*].passengerFareBreakdown[?(@.passengerTypeCode=='INF')]",
      "op": "count",
      "cmp": ">=",
      "value": 1
    }
  ],
  "assert": [
    {
      "step": "Search",
      "path": "$.offers[*].passengerFareBreakdown[?(@.passengerTypeCode=='INF')].segmentDetails.*.baggageDetailsRefId",
      "op": "allNotNull"
    }
  ],
  "reproduces": [
    {
      "step": "Search",
      "path": "$.offers[*].passengerFareBreakdown[?(@.passengerTypeCode=='INF')].segmentDetails.*.baggageDetailsRefId",
      "op": "anyNull"
    }
  ],
  "fixedWhen": "all asserts pass",
  "neighbours": [],
  "notes": "Expectation (INF must carry a baggageDetailsRefId) comes from the bug sheet; confirm against SPEC §2.1 when approving.",
