{
  "id": "NDC-BUG-0003",
  "title": "[V2][AirArabiaPlus][SeatMap] – Occupied Seats Carry Per-Passenger Price Details",
  "source": "Resources/AirArabiaPlus_bugs.xlsx row 4 and row 10 (same defect: totalPrice 0.00 sits inside seatPriceDetailsByPassenger)",
  "supplier": "AirArabiaPlus",
  "selector": "USA",
  "version": "V2",
  "testData": "TestData/AAP_2ADT1CHD1INF_SHJ-AMM_OW.json",
  "chain": [
    {
      "step": "Search",
      "offer": {
        "direct": true
      }
    },
    "FareConfirm",
    "AddPassenger",
    {
      "step": "SeatMap",
      "select": false
    }
  ],
  "preconditions": [
    {
      "step": "SeatMap",
      "path": "$.seatMapDetails.*.rows[*].cells[?(@.cellDetails.cellAvailability=='Occupied')]",
      "op": "count",
      "cmp": ">=",
      "value": 1
    }
  ],
  "assert": [
    {
      "step": "SeatMap",
      "path": "$.seatMapDetails.*.rows[*].cells[?(@.cellDetails.cellAvailability=='Occupied')].cellDetails.seatPriceDetailsByPassenger.*",
      "op": "notExists"
    }
  ],
  "reproduces": [
    {
      "step": "SeatMap",
      "path": "$.seatMapDetails.*.rows[*].cells[?(@.cellDetails.cellAvailability=='Occupied')].cellDetails.seatPriceDetailsByPassenger.*",
      "op": "exists"
    }
  ],
  "fixedWhen": "all asserts pass",
  "neighbours": [
    "FLOW-V2-50"
  ],
  "notes": "Needs at least one Occupied cell on the flight; with none the verdict is Blocked.",
  "approved": {
    "by": "Mostafa Ebrahim Mostafa",
    "date": "2026-11-17",
    "sha": "aa60fdc8191ccf6f"
  }
}
