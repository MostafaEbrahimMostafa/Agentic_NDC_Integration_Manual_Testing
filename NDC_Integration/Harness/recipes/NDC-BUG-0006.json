{
  "id": "NDC-BUG-0006",
  "title": "[V2][AirArabiaPlus][FareCheck] – Services Offered by GetAncillary/SeatMap Are Rejected as \"Not Available\" at FareCheck, Hold or Book (Bundle Flows Often Fail on the First Bundle Code)",
  "source": "Resources/AirArabiaPlus_bugs.xlsx row 7; KB/02_Suppliers/AirArabiaPlus.md §4",
  "supplier": "AirArabiaPlus",
  "selector": "USA",
  "version": "V2",
  "testData": "TestData/AAP_1ADT1CHD1INF_COK-SHJ_OW.json",
  "chain": [
    {
      "step": "Search",
      "offer": {
        "direct": true,
        "flags": {
          "haveBundles": true
        }
      }
    },
    "FareConfirm",
    {
      "step": "GetOfferBundles",
      "prefer": [
        "66580",
        "66589"
      ]
    },
    "AddPassenger",
    {
      "step": "GetAncillary",
      "meal": true,
      "baggage": true
    },
    "SeatMap",
    {
      "step": "FareCheck",
      "allowFail": true
    }
  ],
  "preconditions": [
    {
      "step": "SeatMap",
      "path": "$status",
      "op": "equals",
      "value": 200
    }
  ],
  "assert": [
    {
      "step": "FareCheck",
      "path": "$status",
      "op": "equals",
      "value": 200
    }
  ],
  "reproduces": [
    {
      "step": "FareCheck",
      "path": "$status",
      "op": "equals",
      "value": 409
    },
    {
      "step": "FareCheck",
      "path": "$text",
      "op": "matches",
      "value": "/not available/i"
    }
  ],
  "fixedWhen": "all asserts pass",
  "neighbours": [
    {
      "flow": "FLOW-V2-67",
      "stepOptions": {
        "GetOfferBundles": {
          "bundle": "66624"
        }
      }
    }
  ],
  "notes": "Prefers bundle 66580 (meal LKRRC rejected on 2026-11-16), else 66589 (ADT+CHD+INF rejected). The rejection is not fully deterministic: one run that passes FareCheck gives \"Fixed\" for this offer only - a human signs off before the registry says Fixed-Verified.",
  "approved": {
    "by": "Mostafa Ebrahim Mostafa",
    "date": "2026-11-17",
    "sha": "66260757918ee67f"
  }
}
