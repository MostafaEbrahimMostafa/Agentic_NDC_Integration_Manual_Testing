# Copy this file to .env (same folder, repo root) and fill in the values.
# .env is git-ignored. Get the staging key from the team's secret channel, never from git.
NDC_API_KEY=
NDC_CLIENT_ID=NDC-Core

# Postman MCP server (.mcp.json). Claude Code reads it from the OS environment, NOT from this file:
# set it once per user with   setx POSTMAN_API_KEY "<your PMAK key>"   and restart VS Code.
# POSTMAN_API_KEY=
